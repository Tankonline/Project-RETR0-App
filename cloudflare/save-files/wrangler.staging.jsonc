{
  "$schema": "https://unpkg.com/wrangler@4.155.0/config-schema.json",
  "name": "save-files-staging",
  "main": "src/save-files-worker.js",
  "compatibility_date": "2026-08-22",
  "triggers": {
    "crons": ["*/15 * * * *", "0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "SKINS_DB",
      "database_name": "retr0-save-files-staging",
      "database_id": "80e10844-4552-4cf0-9219-d86caaa1884d",
      "migrations_dir": "migrations-staging"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMMUNITY_BUCKET",
      "bucket_name": "retr0-community-staging"
    },
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "retr0-assets-staging"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ASSET_KV",
      "id": "065596ea1453407f810dabd3598a713c"
    },
    {
      "binding": "SOCIAL_KV",
      "id": "472530dde9ff4b5a9a109f9a9acfb598"
    },
    {
      "binding": "STORAGE_NODE_RATE_LIMIT",
      "id": "83431cdae0664f6f962fed2446d7eac9"
    },
    {
      "binding": "RR3_RAG_CACHE",
      "id": "d2415dca3b034b1b97f94000d2a43247"
    }
  ],
  "vectorize": [
    {
      "binding": "RR3_RAG_INDEX",
      "index_name": "rr3-knowledge"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Bind the dashboard namespace; the worker resolves the retr0-kb instance
  // explicitly with env.KB_SEARCH.get("retr0-kb"). Runtime remains disabled
  // until the binding is validated by an operator.
  "ai_search_namespaces": [
    {
      "binding": "KB_SEARCH",
      "namespace": "retr0-kb"
    }
  ],
  // RAG is explicitly enabled only for this staging deployment. The source
  // allowlist is intentionally limited to the approved RR3 Fandom host.
  "vars": {
    "RR3_RAG_ENABLED": "true",
    "RR3_RAG_ALLOWED_HOSTS": "realracing3.fandom.com",
    "RR3_RAG_REJECTED_HOSTS": "",
    "RR3_RAG_REJECTED_PATHS": "",
    "RR3_RAG_ALLOWED_PATH_PREFIXES": "/ /wiki/ /api/ /dev/",
    "RR3_RAG_SOURCE_ENTRIES": "realracing3.fandom.com|/wiki/Real_Racing_3",
    "RR3_RAG_SOURCE_PATH": "/wiki/Real_Racing_3",
    "RR3_RAG_MANUAL_TRIGGER_ENABLED": "true",
    // Staging-only web research. Provider and gateway are explicit; the worker
    // remains constrained by bounded fetches, robots, SSRF, and review queue.
    "AI_SEARCH_ENABLED": "true",
    "WEB_RESEARCH_ENABLED": "true",
    "WEB_RESEARCH_PROVIDER": "ceramic",
    "WEB_RESEARCH_GATEWAY_ID": "default",
    "WEB_RESEARCH_MAX_RESULTS": "3",
    "WEB_RESEARCH_MAX_FETCHES": "3",
    "WEB_RESEARCH_MAX_QUERY_CHARS": "240",
    "WEB_RESEARCH_MAX_RESULT_CHARS": "4000",
    "WEB_RESEARCH_RATE_LIMIT_MAX": "3",
    "WEB_RESEARCH_RATE_LIMIT_TTL": "3600",
    "WEB_RESEARCH_DAILY_BUDGET": "50",
    "WEB_RESEARCH_ALLOWED_HOSTS": "realracing3.fandom.com",
    "WEB_RESEARCH_ALLOWED_PATH_PREFIXES": "/ /wiki/ /api/ /dev/",
    "WEB_RESEARCH_ROBOTS_REQUIRED": "true",
    "STORAGE_CONTROL_PLANE_MODE": "staging",
    "STORAGE_ENVIRONMENT": "staging",
    "STORAGE_CONTROL_PLANE_ENABLED": "true", "STORAGE_SEED_ENABLED": "true",
    "AUTH_PROVIDER": "firebase",
    "AUTH_ENVIRONMENT": "staging",
    "FIREBASE_PROJECT_ID": "project-retr0",
    "FIREBASE_ISSUER": "https://securetoken.google.com/project-retr0",
    "FIREBASE_AUDIENCE": "project-retr0",
    "AUTH_ISSUER": "https://securetoken.google.com/project-retr0",
    "AUTH_AUDIENCE": "project-retr0",
    "AUTH_JWKS_URL": "https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com",
    "AUTH_RATE_LIMIT_MAX": "30",
    "AUTH_RATE_LIMIT_TTL": "60"
  }
}
