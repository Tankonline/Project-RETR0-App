<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Installation identity and its signing key are device-specific. -->
    <exclude domain="sharedpref" path="community_identity_v1.xml" />
    <!-- Community PFPs are bound to the excluded installation identity. -->
    <exclude domain="file" path="pfp/" />
    <!-- Imported assets and installer staging files can be regenerated or re-downloaded. -->
    <exclude domain="file" path="skins/" />
</full-backup-content>
