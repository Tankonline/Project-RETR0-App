{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Community Server Directory Entry","type":"object","required":["id","displayName","region","status","signalLevel","measuredAt"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{1,63}$"},"displayName":{"type":"string","minLength":1,"maxLength":80},"region":{"type":"string","minLength":1,"maxLength":32},"status":{"enum":["healthy","degraded","offline","draining","unknown"]},"signalLevel":{"type":"integer","minimum":0,"maximum":4},"latencyMs":{"type":["integer","null"],"minimum":0},"availabilityPercent":{"type":["number","null"],"minimum":0,"maximum":100},"capacityPercent":{"type":["number","null"],"minimum":0,"maximum":100},"measuredAt":{"type":"string","format":"date-time"},"supports":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}